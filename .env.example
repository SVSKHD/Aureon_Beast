# Aureon environment — copy to .env and fill in. NEVER commit .env.
# Every variable a phase introduces is listed here (CLAUDE.md working rules).

# ── Firestore / Firebase ──────────────────────────────────────────────────────
# Path to the Firebase service-account JSON. Server-side only; the Vue client
# uses the public web config instead (§71/§72).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
AUREON_FIREBASE_PROJECT_ID=aureon-example

# Set ONLY for tests / local development against the emulator (Phase 4+).
# Leaving this set while pointing at a real project would write to production.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ── Identity & scoping ────────────────────────────────────────────────────────
# account_scope feeds detection_id (Phase 2 §13) — changing it changes every id.
AUREON_ACCOUNT_SCOPE=demo
# Magic number stamped on every Aureon order; orders without it are external (§52).
AUREON_MAGIC=770177

# ── Market clock ──────────────────────────────────────────────────────────────
# IANA zone of the BROKER's server clock. MT5 server time is converted to UTC
# with this; local OS time is never trusted (CLAUDE.md).
AUREON_MARKET_TIMEZONE=Etc/UTC

# ── MetaTrader 5 (Windows only; imported lazily) ───────────────────────────────
AUREON_MT5_LOGIN=
AUREON_MT5_PASSWORD=
AUREON_MT5_SERVER=
AUREON_MT5_TERMINAL_PATH=
# Phase 4 "done when" records the demo login and server used for the live
# end-to-end market + pending order. Password is never recorded anywhere.
AUREON_MT5_DEMO_LOGIN_USED=
AUREON_MT5_DEMO_SERVER_USED=

# ── Observer (Phase 2) ────────────────────────────────────────────────────────
AUREON_SYMBOLS=XAUUSD
AUREON_TIMEFRAMES=M5
# Throttle for system_state writes outside candle closes (Phase 2 §6).
AUREON_STATE_HEARTBEAT_SECONDS=5
AUREON_OUTBOX_PATH=outbox.db
AUREON_OBSERVER_STATE_PATH=observer_state.json

# ── Executor (Phase 4) ────────────────────────────────────────────────────────
AUREON_EXECUTOR_POLL_SECONDS=2
# Grace before an EXECUTING request with zero broker matches is failed (§5).
AUREON_RECONCILE_GRACE_SECONDS=120
AUREON_EXECUTOR_LEASE_SECONDS=60

# ── Position monitor (Phase 5) ────────────────────────────────────────────────
AUREON_MONITOR_POLL_SECONDS=2

# ── Discord (Phase 6) ─────────────────────────────────────────────────────────
AUREON_DISCORD_TOKEN=
AUREON_DISCORD_GUILD_ID=
# Comma-separated Discord user ids allowed to command Aureon.
AUREON_AUTHORIZED_USER_IDS=
# How far back /execute-trade offers detections to link (Phase 6 §37).
AUREON_LINK_WINDOW_MINUTES=90

# ── Reviews (Phase 7) ─────────────────────────────────────────────────────────
# Window after a detection in which a trade may be INFERRED as linked (§50).
# Kept separate from AUREON_LINK_WINDOW_MINUTES: that one is an explicit human
# link, this one is a statistical guess and never written onto a trade.
AUREON_INFER_WINDOW_MINUTES=30
