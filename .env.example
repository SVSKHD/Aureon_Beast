# Aureon environment — copy to .env and fill in. NEVER commit .env.
# Every variable a phase introduces is listed here (CLAUDE.md working rules).

# ── Firestore / Firebase ──────────────────────────────────────────────────────
# Path to the Firebase service-account JSON. Server-side only; the Vue client
# uses the public web config instead (§71/§72).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
AUREON_FIREBASE_PROJECT_ID=aureon-example

# Set ONLY for tests / local development against the emulator (Phase 4+).
# Leaving this set while pointing at a real project would write to production.
# Start it with `make emulator`, then: export FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#
# gRPC honours its OWN proxy variables, so behind an HTTP proxy the emulator is
# unreachable ("Expected SETTINGS frame as the first frame") unless localhost is
# bypassed for gRPC specifically. This does not disable the proxy for anything else.
# no_grpc_proxy=127.0.0.1,localhost

# ── Identity & scoping ────────────────────────────────────────────────────────
# account_scope feeds detection_id (§12) — changing it re-keys ALL history.
# Deliberately an alias, not the broker login, so a broker migration does not
# re-key history. Set before Phase 2 and never change it (decision 4).
# Every Firestore collection is {prefix}_{name}, e.g. aureon_beast_detections. One
# variable moves a whole deployment's data, and it is the ONLY thing separating a test
# run from production data in the same project. Tests override it to aureon_test and
# refuse to run on this default without an emulator host.
AUREON_COLLECTION_PREFIX=aureon_beast

AUREON_ACCOUNT_SCOPE=primary
# Magic number stamped on every Aureon order; orders without it are external (§52).
AUREON_MAGIC=770177

# ── Market clock ──────────────────────────────────────────────────────────────
# IANA zone of the BROKER's server clock. MT5 server time is converted to UTC
# with this; local OS time is never trusted (CLAUDE.md). Typical MT5 server
# clock, DST-aware (§8, decision 6).
AUREON_MARKET_TZ=Europe/Athens

# ── MetaTrader 5 (Windows only; imported lazily) ───────────────────────────────
AUREON_MT5_LOGIN=
AUREON_MT5_PASSWORD=
AUREON_MT5_SERVER=
AUREON_MT5_TERMINAL_PATH=
# Phase 4 "done when" records the demo login and server used for the live
# end-to-end market + pending order. Password is never recorded anywhere.
AUREON_MT5_DEMO_LOGIN_USED=
AUREON_MT5_DEMO_SERVER_USED=

# ── Observer (Phase 2) ────────────────────────────────────────────────────────
AUREON_SYMBOLS=XAUUSD

# EMA cross periods (§13). EmaCrossAgent has NO default pair -- these are the only
# place the live periods are decided. Changing them is an agent_version bump, because
# the periods are in agent_params_snapshot and the version is in the detection id.
AUREON_EMA_FAST=20
AUREON_EMA_SLOW=50

# How many candles back a sweep or wick still counts as context for a cross (§23).
AUREON_CONTEXT_WINDOW_CANDLES=3

# Per-symbol agent thresholds (D-15). The liquidity/breakout/wick numbers are v1.0.0
# PLACEHOLDERS chosen to be plausible on gold and researched on nothing -- every
# baseline count for those agents is "events these arbitrary numbers selected", not a
# measurement. They are NOT dimensionless: 5 points is $0.05 on XAUUSD and means
# something else on a symbol with a different tick.
#
# The observer REFUSES TO START on a symbol with no entry in
# aureon/config/symbol_tuning.py (P-6). Running an unreviewed instrument on gold's
# numbers produces detections that look like sweeps and are noise, and nothing
# downstream can tell -- a sweep is a sweep once it is written. Reviewed today: XAUUSD
# and XAGUSD. An EMPTY entry is a valid answer; it means the defaults were reviewed and
# kept, which is a different statement from nobody having looked.
#
# Changing any of them is a NEW agent_version, because the values are in
# agent_params_snapshot and the version is part of the detection_id.
#
# The variables below are for a one-off experiment only -- a threshold set from an
# environment variable is one nobody can reconstruct from the repository six months
# later, so anything worth keeping belongs in the table, in a commit.
# AUREON_TUNING_XAUUSD_MIN_PENETRATION_POINTS=5.0
# AUREON_TUNING_XAGUSD_MIN_PENETRATION_POINTS=1.0
AUREON_TIMEFRAMES=M5
# Throttle for system_state writes outside candle closes (Phase 2 §6).
AUREON_STATE_HEARTBEAT_SECONDS=5
AUREON_OUTBOX_PATH=outbox.db
AUREON_OBSERVER_STATE_PATH=observer_state.json

# ── Execution settings (§84) ──────────────────────────────────────────────────
# Env supplies the defaults; Firestore settings/execution WINS AT RUNTIME
# (decision 11). trading_enabled is not here: it is Firestore-only and
# defaults to false, so a fresh deploy cannot trade until a human enables it.
AUREON_CONFIRMATION_TTL_SECONDS=60
AUREON_QUOTE_TTL_SECONDS=15
AUREON_STATUS_STALE_AFTER_SECONDS=45
AUREON_MAX_DEVIATION_POINTS=20
AUREON_MAX_SPREAD_POINTS=50
AUREON_MAX_LOT=1.0
AUREON_EXECUTOR_LEASE_SECONDS=60

# Evaluation rule applied by the outcome tracker (§84). Frozen once shipped —
# a threshold change is a NEW rule_id, never an edit (Phase 3).
# Which frozen outcome rule the observer and backfill evaluate against.
# XAU_OUTCOME_V2 measures in PRICE ($3-$20); EMA_OUTCOME_V1 measured in points
# ($0.03-$0.20 on gold) and is kept only so its stored results stay readable.
AUREON_EVAL_RULE=XAU_OUTCOME_V2

# ── Executor (Phase 4) ────────────────────────────────────────────────────────
AUREON_EXECUTOR_POLL_SECONDS=2
# Grace before an EXECUTING request with zero broker matches is failed (§5).
AUREON_RECONCILE_GRACE_SECONDS=120

# ── Position monitor (Phase 5) ────────────────────────────────────────────────
AUREON_MONITOR_POLL_SECONDS=2

# ── Discord (Phase 6) ─────────────────────────────────────────────────────────
AUREON_DISCORD_TOKEN=
AUREON_DISCORD_GUILD_ID=
# Comma-separated Discord user ids allowed to command Aureon.
AUREON_AUTHORIZED_USER_IDS=
# How far back /execute-trade offers detections to link (Phase 6 §37).
AUREON_LINK_WINDOW_MINUTES=90

# ── Reviews (Phase 7) ─────────────────────────────────────────────────────────
# Window after a detection in which a trade may be INFERRED as linked (§50).
# Kept separate from AUREON_LINK_WINDOW_MINUTES: that one is an explicit human
# link, this one is a statistical guess and never written onto a trade.
AUREON_INFER_WINDOW_MINUTES=30
