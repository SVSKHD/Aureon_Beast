# Aureon environment — copy to .env and fill in. NEVER commit .env.
# Every variable a phase introduces is listed here (CLAUDE.md working rules).

# ── Local application storage ──────────────────────────────────────────────────
# Current phase: ALL operational application state stays on this Windows machine.
# SQLite runs in WAL mode and is shared by observer/monitor/executor/Discord/review.
# MT5 remains broker truth; Parquet remains the candle archive; outbox.db remains
# durable delivery protection.
AUREON_STORAGE_BACKEND=sqlite
AUREON_LOCAL_DB_PATH=data/aureon.db

# ── PostgreSQL placeholder for next week's decision ────────────────────────────
# NOT used by the current runtime. Keep these blank until the backend decision is made.
# AUREON_STORAGE_BACKEND=postgres
# AUREON_DATABASE_URL=postgresql+psycopg://aureon:CHANGE_ME@127.0.0.1:5432/aureon
# AUREON_DB_STARTUP_WAIT_SECONDS=120

# ── Identity & scoping ────────────────────────────────────────────────────────
# account_scope feeds detection_id (§12) — changing it re-keys ALL history.
# Deliberately an alias, not the broker login, so a broker migration does not
# re-key history. Set before Phase 2 and never change it (decision 4).
AUREON_ACCOUNT_SCOPE=primary
# Magic number stamped on every Aureon order; orders without it are external (§52).
AUREON_MAGIC=770177

# ── Market clock ──────────────────────────────────────────────────────────────
# IANA zone of the BROKER's server clock. MT5 server time is converted to UTC
# with this; local OS time is never trusted (CLAUDE.md). Typical MT5 server
# clock, DST-aware (§8, decision 6).
AUREON_MARKET_TZ=Europe/Athens

# ── MetaTrader 5 (Windows only; imported lazily) ───────────────────────────────
# LEAVE THESE BLANK for the normal setup. Aureon attaches to the MT5 terminal that is
# already running and logged in: you log the terminal in once, and every service attaches
# to that account. The preflight's `mt5_account` row then PASSES and prints which account
# it attached to -- login, server, mode, currency and trade_allowed (12, T-3).
#
# Fill them in only as OVERRIDES, when there is a reason:
#   * more than one terminal on the box, so the path has to be pinned;
#   * a login that must be verified rather than accepted, e.g. on a machine where somebody
#     could plausibly leave the wrong account logged in. With LOGIN and/or SERVER set, the
#     preflight FAILS on a mismatch instead of reporting what it found.
# A password here is only needed if Aureon must perform the login itself. It is a secret in
# a file: prefer logging the terminal in by hand and leaving this blank.
AUREON_MT5_LOGIN=
AUREON_MT5_PASSWORD=
AUREON_MT5_SERVER=
AUREON_MT5_TERMINAL_PATH=
# Phase 4 "done when" records the demo login and server used for the live
# end-to-end market + pending order. Password is never recorded anywhere.
AUREON_MT5_DEMO_LOGIN_USED=
AUREON_MT5_DEMO_SERVER_USED=

# ── The launcher (12, T-1) ────────────────────────────────────────────────────
# `python main_aureon.py` starts the five services. On Ctrl+C it interrupts them in reverse
# order and waits this long before terminating anything, because the observer's shutdown
# drains the outbox, flushes the parquet archive and saves its cursor. Zero and negative are
# refused (they would mean "terminate at once", which is what the grace prevents).
AUREON_SHUTDOWN_GRACE_SECONDS=20

# ── Observer (Phase 2) ────────────────────────────────────────────────────────
# Comma-separated. With more than one symbol, AUREON_EVAL_RULES below must name every
# one of them, and every one needs an entry in aureon/config/symbol_tuning.py.
AUREON_SYMBOLS=XAUUSD,XAGUSD

# EMA cross periods (§13). EmaCrossAgent has NO default pair -- these are the only
# place the live periods are decided. Changing them is an agent_version bump, because
# the periods are in agent_params_snapshot and the version is in the detection id.
AUREON_EMA_FAST=20
AUREON_EMA_SLOW=50

# How many candles back a sweep or wick still counts as context for a cross (§23).
AUREON_CONTEXT_WINDOW_CANDLES=3

# Per-symbol agent thresholds (D-15). The liquidity/breakout/wick numbers are v1.0.0
# PLACEHOLDERS chosen to be plausible on gold and researched on nothing -- every
# baseline count for those agents is "events these arbitrary numbers selected", not a
# measurement. They are NOT dimensionless: 5 points is $0.05 on XAUUSD and means
# something else on a symbol with a different tick.
#
# The observer REFUSES TO START on a symbol with no entry in
# aureon/config/symbol_tuning.py (P-6). Running an unreviewed instrument on gold's
# numbers produces detections that look like sweeps and are noise, and nothing
# downstream can tell -- a sweep is a sweep once it is written. Reviewed today: XAUUSD
# and XAGUSD. An EMPTY entry is a valid answer; it means the defaults were reviewed and
# kept, which is a different statement from nobody having looked.
#
# Changing any of them is a NEW agent_version, because the values are in
# agent_params_snapshot and the version is part of the detection_id.
#
# The variables below are for a one-off experiment only -- a threshold set from an
# environment variable is one nobody can reconstruct from the repository six months
# later, so anything worth keeping belongs in the table, in a commit.
# AUREON_TUNING_XAUUSD_MIN_PENETRATION_POINTS=5.0
# AUREON_TUNING_XAGUSD_MIN_PENETRATION_POINTS=1.0
AUREON_TIMEFRAMES=M5
# Throttle for system_state writes outside candle closes (Phase 2 §6).
AUREON_STATE_HEARTBEAT_SECONDS=5
AUREON_OUTBOX_PATH=outbox.db
AUREON_OBSERVER_STATE_PATH=observer_state.json

# ── Execution settings (§84) ──────────────────────────────────────────────────
# Env supplies safe defaults; the local database settings/execution row wins at runtime.
# trading_enabled is database-backed and defaults to false, so a fresh local database
# cannot trade until a human enables it.
AUREON_CONFIRMATION_TTL_SECONDS=60
AUREON_QUOTE_TTL_SECONDS=15
AUREON_STATUS_STALE_AFTER_SECONDS=45
AUREON_MAX_DEVIATION_POINTS=20
AUREON_MAX_SPREAD_POINTS=50
AUREON_MAX_LOT=1.0
AUREON_EXECUTOR_LEASE_SECONDS=60

# Evaluation rule applied by the outcome tracker (§84). Frozen once shipped —
# a threshold change is a NEW rule_id, never an edit (Phase 3).
# Which frozen outcome rule the observer and backfill evaluate against.
# XAU_OUTCOME_V2 measures in PRICE ($3-$20); EMA_OUTCOME_V1 measured in points
# ($0.03-$0.20 on gold) and is kept only so its stored results stay readable.
# Used only for a SINGLE-symbol deployment; see AUREON_EVAL_RULES.
AUREON_EVAL_RULE=XAU_OUTCOME_V2

# Per-symbol outcome rules. REQUIRED once AUREON_SYMBOLS names more than one symbol,
# and the observer refuses to start without an entry for each. A rule's thresholds are
# in the instrument's own money: XAU_OUTCOME_V2's $3-$20 is 10-65% of silver's price, so
# sharing it would make every XAGUSD horizon read "not reached" and fill the reached-N
# table with zeros that look like a finding about silver and are a unit error.
AUREON_EVAL_RULES=XAUUSD:XAU_OUTCOME_V2,XAGUSD:XAG_OUTCOME_V1

# ── Executor (Phase 4) ────────────────────────────────────────────────────────
AUREON_EXECUTOR_POLL_SECONDS=2
# Grace before an EXECUTING request with zero broker matches is failed (§5).
AUREON_RECONCILE_GRACE_SECONDS=120

# ── Position monitor (Phase 5) ────────────────────────────────────────────────
AUREON_MONITOR_POLL_SECONDS=2

# ── Sleeping through the close (11B) ──────────────────────────────────────────
# CLOSED must hold on EVERY configured symbol for this long before a service parks its
# loops. One closed poll is a broker hiccup far more often than it is the weekend, and a
# premature sleep would fire the once-per-close work mid-session.
AUREON_CLOSE_CONFIRM_SECONDS=300
# How far before the scheduled open a sleeping service wakes itself. Being up AT the open
# is too late: the observer still has a backfill to do and a cursor to seed.
AUREON_PREOPEN_SECONDS=900
# Heartbeat cadence while asleep. Slow, never absent -- a heartbeat that stopped would be
# indistinguishable from a process that died over the weekend.
AUREON_SLEEP_HEARTBEAT_SECONDS=300
# How often a sleeping service asks whether the market is open yet.
AUREON_SLEEP_POLL_SECONDS=60

# ── Runtime guardian / self-healing ───────────────────────────────────────────
# Opt-in only. When true and the checkout is on a CLEAN local main branch, the supervisor
# periodically fetches origin/main. A fast-forward update is preflighted, the children are
# stopped cooperatively, and main_aureon.py re-execs itself on the new commit.
AUREON_AUTO_UPDATE_MAIN=false
# A live-market feed that has not advanced for this long may request ONE full-stack restart.
# The guardian remembers the last stale tick timestamp, so the same dead feed cannot create an
# endless restart loop. 10800 seconds = 3 hours.
AUREON_AUTO_RESTART_STALE_FEED=false
AUREON_STALE_FEED_RESTART_SECONDS=10800
# How often the supervisor checks git and persisted market liveness.
AUREON_GUARDIAN_POLL_SECONDS=120
# Weekend closure is never restarted. Once the schedule is closed and the tick has been quiet
# past the threshold above, /ops reports market_holiday until the weekly market reopens.

# ── Higher timeframes (11D) ───────────────────────────────────────────────────
# How many M5 bars the engine keeps for aggregating M15/M30/H1/H4/D1. Separate from the
# analysis window, which is a correctness parameter and must not be widened for this.
# 2880 is ten 24-hour days: enough for an H4 EMA(50). D1 needs fifty trading days and comes
# from the market_day_frames cache instead. Zero disables the context.
AUREON_MTF_M5_BARS=2880

# ── Discord (Phase 6) ─────────────────────────────────────────────────────────
AUREON_DISCORD_TOKEN=
AUREON_DISCORD_GUILD_ID=
# Where detection embeds and fired reminders are posted (9C). Leave empty and Aureon
# announces nothing: a deployment that has not chosen a channel must not start posting
# into whichever one it can see.
AUREON_ALERT_CHANNEL_ID=
# How far back the notifier looks for detections it has not announced yet. Two minutes by
# default: long enough to survive a restart, short enough that a bot which was down for an
# hour does not wake and post an hour of history at once.
AUREON_NOTIFY_WINDOW_SECONDS=120
# Comma-separated Discord user ids allowed to command Aureon.
AUREON_AUTHORIZED_USER_IDS=
# How far back /execute-trade offers detections to link (Phase 6 §37).
AUREON_LINK_WINDOW_MINUTES=90

# ── Reviews (Phase 7) ─────────────────────────────────────────────────────────
# Window after a detection in which a trade may be INFERRED as linked (§50).
# Kept separate from AUREON_LINK_WINDOW_MINUTES: that one is an explicit human
# link, this one is a statistical guess and never written onto a trade.
AUREON_INFER_WINDOW_MINUTES=30

# ── 11A F-3: the live-account gate ────────────────────────────────────────────
# Whether the EXECUTOR may place orders on a real-money account.
#
# Only the exact string "true" unlocks it. "1", "yes", "on" and a leftover "false" all leave
# it locked -- a flag whose job is to be hard to set by accident should be hard to set by
# accident. Unset means the executor starts in reconcile-only mode on a live terminal:
# startup reconciliation runs, every request is refused with `live_execution_not_allowed`,
# and one ops message says which terminal is open.
#
# Deliberately an environment variable and not a database setting. `trading_enabled` is a
# switch a human flips in Discord in a hurry; this is a line somebody wrote on the machine
# while looking at which terminal was open. Collapsing the two would defeat both.
#
# Observation is unaffected: the observer and monitor are read-only and run on a live
# account quite happily, and publish `system_state.account_mode` so /status says which.
AUREON_ALLOW_LIVE_EXECUTION=
